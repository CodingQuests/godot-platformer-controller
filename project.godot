; Engine configuration file.
; Godot Platformer Controller
; A 2D platformer player with coyote time, jump buffering, variable jump height,
; double jump, air dash, wall slide and wall jump. Open in Godot 4.7+, press F5.

config_version=5

[application]

config/name="Godot Platformer Controller"
config/description="A 2D platformer controller for Godot 4 with coyote time, jump buffering, variable jump height, double jump, dash, wall slide and wall jump. From codingquests.io"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/kenney_pixel-platformer/Tiles/Characters/tile_0000.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

